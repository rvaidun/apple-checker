# Copy to .env and fill in. .env is git-ignored.

# Discord channel webhook: Server Settings > Integrations > Webhooks > Copy Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/XXXXXXXX

# Comma-separated Discord user IDs to tag when something is in stock.
# (Discord: Settings > Advanced > Developer Mode, then right-click a user > Copy User ID)
DISCORD_TAG_USER_IDS=111111111111111111,222222222222222222
